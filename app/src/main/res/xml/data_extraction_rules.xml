<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Guarantee 100% offline-first privacy: only preferences are backed up, database is omitted -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow direct encrypted device-to-device migration between user's devices -->
        <include domain="database" path="oikos_grocery.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>